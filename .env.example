# Database
POSTGRES_SERVER=postgres
POSTGRES_USER=ch_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=computehub

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=models

# Clerk Authentication
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_ISSUER_URL=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUDIENCE=your_api_audience

# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key_here

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENABLE_LOCAL_PROVIDER=false
INTERNAL_API_URL=http://backend:8000

# License Server (required for license activation)
LICENSE_SERVER_URL=http://license-server:8000
LICENSE_API_SECRET=change-me-in-productiona_api_key_here

# App
SECRET_KEY=supersecretkey
ENVIRONMENT=development
APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SSH_KNOWN_HOSTS=/app/ssh_known_hosts

# Provider API Keys
RUNPOD_API_KEY=your_runpod_api_key_here
VASTAI_API_KEY=your_vastai_api_key_here
LAMBDA_API_KEY=your_lambda_api_key_here
